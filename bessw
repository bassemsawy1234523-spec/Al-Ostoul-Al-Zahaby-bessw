        async function executeDebtTransactionSubmit(e) {
            e.preventDefault();
            let debtId = document.getElementById('dtDebtId').value;
            let isInterest = document.getElementById('dtDebtIsInterest').value === 'true';
            let actionType = document.getElementById('dtActionType').value;
            let deductType = (isInterest && actionType === 'تسليم (سداد)') ? document.getElementById('dtDeductType').value : 'عادي';
            let amount = Number(document.getElementById('dtAmount').value);
            let method = document.getElementById('dtMethod').value;
            let note = document.getElementById('dtNote').value;

            if (amount <= 0) { alert('يرجى إدخال مبلغ صحيح أكبر من الصفر'); return; }

            let receiptImages = await filesToMultipleBase64('dtReceiptImgFile');

            db.ref(`debts/${debtId}`).once('value', snapshot => {
                if (!snapshot.exists()) return;
                let d = snapshot.val();

                let now = new Date();
                let timestamp = now.toLocaleString('ar-EG');
                let isoDate = now.toISOString();
                let updates = {};

                let fullNote = note ? `${note} [${deductType}]` : `[${deductType}]`;

                let transRef = db.ref('debt_transactions').push().key;
                updates[`debt_transactions/${transRef}`] = { 
                    debtId, 
                    timestamp, 
                    isoDate, 
                    actionType, 
                    amount, 
                    method, 
                    deductType,
                    note: fullNote,
                    receiptImages
                };

                let treasuryRef = db.ref('treasury_logs').push().key;
                if (actionType === 'تسليم (سداد)') {
                    updates[`treasury_logs/${treasuryRef}`] = { 
                        isoDate, 
                        timestamp, 
                        type: 'سحب', 
                        amount, 
                        method,
                        note: `تسليم للدائن (${d.name}) - البيان: ${fullNote}`,
                        receiptImages 
                    };

                    if (d.type === 'فائدة') {
                        if (deductType === 'من أصل المبلغ') {
                            updates[`debts/${debtId}/principal`] = firebase.database.ServerValue.increment(-amount);
                        }
                    } else {
                        updates[`debts/${debtId}/paidAmount`] = firebase.database.ServerValue.increment(amount);
                    }
                } else {
                    updates[`treasury_logs/${treasuryRef}`] = { 
                        isoDate, 
                        timestamp, 
                        type: 'إيداع', 
                        amount, 
                        method,
                        note: `استلام من الدائن (${d.name}) - البيان: ${fullNote}`,
                        receiptImages 
                    };

                    if (d.type === 'فائدة') {
                        updates[`debts/${debtId}/principal`] = firebase.database.ServerValue.increment(amount);
                    } else {
                        updates[`debts/${debtId}/paidAmount`] = firebase.database.ServerValue.increment(-amount);
                    }
                }

                db.ref().update(updates).then(() => {
                    alert(`تم تسجيل حركة الـ (${actionType}) بنجاح والتسميع المباشر في الخزنة والدين!`);
                    closeModal('debtTransactionModal');
                    openDebtAccountDetails(debtId);
                    updateSecretTickerData();
                });
            });
        }

        function editDebtTransactionNote(trKey, debtId, currentNote) {
            let newNote = prompt("تعديل البيان / الملاحظة للحركة المالية:", currentNote);
            if (newNote !== null) {
