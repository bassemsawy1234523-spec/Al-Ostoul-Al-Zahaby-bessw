            const type = document.getElementById('debtType').value;
            const data = {
                type: type,
                name: document.getElementById('debtName').value,
                phone: document.getElementById('debtPhone').value
            };

            if (type === 'ثابت') {
                data.amount = Number(document.getElementById('debtAmount').value);
                data.dueDate = document.getElementById('debtFixedDueDate').value;
            } else {
                data.principal = Number(document.getElementById('debtPrincipal').value);
                data.monthlyInterest = Number(document.getElementById('debtMonthlyInterest').value);
                data.dueDate = document.getElementById('debtInterestDueDateDay').value;
            }

            if (id) {
                db.ref(`debts/${id}`).update(data).then(() => { alert('تم تعديل الدين بنجاح'); resetDebtForm(); updateSecretTickerData(); });
            } else {
                data.paidAmount = 0;
                db.ref('debts').push(data).then(() => { alert('تم حفظ الدين بنجاح'); resetDebtForm(); updateSecretTickerData(); });
            }
        }

