        function deleteDebtTransaction(trKey, debtId, actionType, amount, deductType) {
            if (!confirm("هل أنت متأكد من حذف هذه الحركة؟ سيتم إلغاء أثرها المالي وإرجاع المبالغ للخزنة والدين.")) return;

            db.ref(`debts/${debtId}`).once('value').then(snap => {
                if (!snap.exists()) return;
                let d = snap.val();
                let updates = {};

                updates[`debt_transactions/${trKey}`] = null;

                let numAmount = Number(amount);
                let now = new Date();
                let timestamp = now.toLocaleString('ar-EG');
                let isoDate = now.toISOString();

                let treasuryRef = db.ref('treasury_logs').push().key;
                if (actionType === 'تسليم (سداد)') {
                    updates[`treasury_logs/${treasuryRef}`] = {
                        isoDate, timestamp, type: 'إيداع', amount: numAmount, method: 'كاش', note: `إلغاء حركة تسليم للدائن (${d.name})`
                    };
                    if (d.type === 'فائدة') {
                        if (deductType === 'من أصل المبلغ') {
                            updates[`debts/${debtId}/principal`] = firebase.database.ServerValue.increment(numAmount);
                        }
                    } else {
                        updates[`debts/${debtId}/paidAmount`] = firebase.database.ServerValue.increment(-numAmount);
                    }
                } else {
                    updates[`treasury_logs/${treasuryRef}`] = {
                        isoDate, timestamp, type: 'سحب', amount: numAmount, method: 'كاش', note: `إلغاء حركة استلام من الدائن (${d.name})`
                    };
                    if (d.type === 'فائدة') {
                        updates[`debts/${debtId}/principal`] = firebase.database.ServerValue.increment(-numAmount);
                    } else {
                        updates[`debts/${debtId}/paidAmount`] = firebase.database.ServerValue.increment(numAmount);
                    }
                }

                db.ref().update(updates).then(() => {
                    alert("تم حذف الحركة وإلغاء التأثير المالي بنجاح!");
                    openDebtAccountDetails(debtId);
                    updateSecretTickerData();
                });
            });
        }

