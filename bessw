                    document.getElementById('debtPrincipal').value = d.principal || 0;
                    document.getElementById('debtMonthlyInterest').value = d.monthlyInterest || 0;
                    document.getElementById('debtInterestDueDateDay').value = d.dueDate || '';
                } else {
                    document.getElementById('debtAmount').value = d.amount || 0;
