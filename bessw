        async function saveRevenue(e) {
            e.preventDefault();
            const tripId = document.getElementById('revTripId').value;
            const carId = document.getElementById('revCar').value;
            const driverId = document.getElementById('revDriver').value;
            const totalRev = Number(document.getElementById('totalRev').value);
            
            const payCash = Number(document.getElementById('payCash').value || 0);
            const payVodafone = Number(document.getElementById('payVodafone').value || 0);
            const payInstapay = Number(document.getElementById('payInstapay').value || 0);

            const tripFuel = Number(document.getElementById('tripFuel').value);
            const personalExp = Number(document.getElementById('personalExp').value);
            const roadFee = Number(document.getElementById('roadFee').value);
            const foodExp = Number(document.getElementById('foodExp').value);

            const totalExpenses = tripFuel + personalExp + roadFee + foodExp;
            const netRevenue = totalRev - totalExpenses;
            const totalSplit = payCash + payVodafone + payInstapay;

            if (totalSplit !== netRevenue && totalSplit !== totalRev && totalSplit > 0) {
                if (!confirm(`مجموع طرق الدفع الموزعة (${totalSplit} ج.م) لا يساوي الصافي (${netRevenue} ج.م) ولا الإجمالي (${totalRev} ج.م).\nهل تريد المتابعة على أية حال؟`)) {
                    return;
                }
            }

            // رفع الصور الخاصة بكل طريقة دفع بشكل منفصل
            let cashImgs = await filesToMultipleBase64('payCashImg');
            let vodafoneImgs = await filesToMultipleBase64('payVodafoneImg');
            let instapayImgs = await filesToMultipleBase64('payInstapayImg');

            let allReceiptImages = [...cashImgs, ...vodafoneImgs, ...instapayImgs];

            db.ref(`drivers/${driverId}`).once('value', async driverSnap => {
                let driver = driverSnap.val();
                
                let driverShare = netRevenue * ((driver.percentage || 0) / 100);
                let carShare = netRevenue - driverShare;
                
                let now = new Date();
                let isoDate = now.toISOString();
                let timestamp = now.toLocaleString('ar-EG');

                if (tripId) {
                    db.ref(`trips/${tripId}`).once('value', oldTripSnap => {
                        if (oldTripSnap.exists()) {
                            let oldT = oldTripSnap.val();
                            let updates = {};

                            let finalImages = allReceiptImages.length > 0 ? allReceiptImages : (oldT.receiptImages || []);

                            updates[`drivers/${oldT.driverId}/balance`] = firebase.database.ServerValue.increment(-oldT.driverShare);
                            updates[`cars/${oldT.carId}/totalEarnings`] = firebase.database.ServerValue.increment(-oldT.carShare);
                            
                            if (oldT.treasuryLogId) {
                                updates[`treasury_logs/${oldT.treasuryLogId}`] = {
                                    isoDate, timestamp, type: 'إيداع', amount: netRevenue, note: 'تعديل إيراد رحلة',
                                    method: payCash > 0 ? 'كاش' : (payVodafone > 0 ? 'فودافون كاش' : 'انستا باي'),
                                    receiptImages: finalImages
                                };
                            }

                            updates[`trips/${tripId}`] = { 
                                isoDate: oldT.isoDate || isoDate, 
                                timestamp: oldT.timestamp || timestamp, 
                                carId, driverId, totalRev, totalExpenses, netRevenue, driverShare, carShare,
                                tripFuel, personalExp, roadFee, foodExp,
                                payCash, payVodafone, payInstapay,
                                receiptImages: finalImages,
                                treasuryLogId: oldT.treasuryLogId || null
                            };

                            updates[`drivers/${driverId}/balance`] = firebase.database.ServerValue.increment(driverShare);
                            updates[`cars/${carId}/totalEarnings`] = firebase.database.ServerValue.increment(carShare);

                            db.ref().update(updates).then(() => {
                                alert('تم تعديل الرحلة وتحديث الحسابات بنجاح!');
                                resetRevenueForm();
                                updateSecretTickerData();
                            });
                        }
                    });
                } else {
                    let updates = {};
                    let newTripRef = db.ref('trips').push().key;
                    let treasuryRef = db.ref('treasury_logs').push().key;

                    updates[`trips/${newTripRef}`] = { 
                        isoDate, timestamp, carId, driverId, totalRev, totalExpenses, netRevenue, driverShare, carShare,
                        tripFuel, personalExp, roadFee, foodExp, 
                        payCash, payVodafone, payInstapay,
                        receiptImages: allReceiptImages, treasuryLogId: treasuryRef
                    };
                    updates[`drivers/${driverId}/balance`] = firebase.database.ServerValue.increment(driverShare);
                    updates[`cars/${carId}/totalEarnings`] = firebase.database.ServerValue.increment(carShare);
                    
                    let mainMethod = 'كاش';
                    if (payVodafone > payCash && payVodafone >= payInstapay) mainMethod = 'فودافون كاش';
                    else if (payInstapay > payCash && payInstapay > payVodafone) mainMethod = 'انستا باي';

                    updates[`treasury_logs/${treasuryRef}`] = { 
                        isoDate, timestamp, type: 'إيداع', amount: netRevenue, 
                        method: mainMethod, note: `إيراد رحلة (كاش: ${payCash}, فودافون: ${payVodafone}, انستا: ${payInstapay})`,
                        receiptImages: allReceiptImages 
                    };

                    db.ref().update(updates).then(() => {
                        alert('تم الحفظ وتوزيع الحسابات وتحديث الخزنة بنجاح!');
                        resetRevenueForm();
                        updateSecretTickerData();
                    });
                }
            });
        }

