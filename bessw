<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>الأسطول الذهبي - النظام الشامل والتقارير</title>
    <!-- Firebase SDKs -->
    <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-database-compat.js"></script>
    <!-- html2pdf Library لتصدير ملفات PDF -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <style>
        :root {
            --primary: #d4af37;
            --dark: #121212;
            --light-dark: #1e1e1e;
            --card-bg: #252525;
            --text: #ffffff;
            --gray: #aaaaaa;
            --success: #28a745;
            --danger: #dc3545;
            --info: #17a2b8;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: Tahoma, sans-serif; }
        body { background-color: var(--dark); color: var(--text); padding-bottom: 70px; }
        header { background: var(--light-dark); padding: 15px; text-align: center; border-bottom: 2px solid var(--primary); font-size: 20px; font-weight: bold; color: var(--primary); }
        
        .nav-tabs { display: flex; background: var(--light-dark); overflow-x: auto; border-bottom: 1px solid #333; position: sticky; top: 0; z-index: 100; }
        .nav-tab { padding: 12px 15px; color: var(--gray); cursor: pointer; white-space: nowrap; border-bottom: 3px solid transparent; font-size: 14px; }
        .nav-tab.active { color: var(--primary); border-bottom-color: var(--primary); font-weight: bold; }

        .container { padding: 15px; max-width: 850px; margin: auto; }
        .section { display: none; }
        .section.active { display: block; }

        .card { background: var(--card-bg); padding: 15px; border-radius: 10px; margin-bottom: 15px; border: 1px solid #333; }
        h2 { font-size: 18px; margin-bottom: 12px; color: var(--primary); border-bottom: 1px solid #444; padding-bottom: 5px; }

        label { display: block; margin-bottom: 5px; font-size: 13px; color: var(--gray); }
        input, select, textarea { width: 100%; padding: 10px; margin-bottom: 12px; background: #333; border: 1px solid #444; color: var(--text); border-radius: 5px; font-size: 14px; }
        button { background: var(--primary); color: #000; border: none; padding: 12px; width: 100%; border-radius: 5px; font-weight: bold; cursor: pointer; font-size: 15px; }
        button:hover { opacity: 0.9; }
        
        .btn-group { display: flex; gap: 5px; margin-top: 10px; flex-wrap: wrap; }
        .btn-success { background: var(--success); color: #fff; }
        .btn-danger { background: var(--danger); color: #fff; }
        .btn-info { background: var(--info); color: #fff; }
        .btn-pdf { background: #e74c3c; color: #fff; }
        .btn-share { background: #8e44ad; color: #fff; }
        .btn-sm { padding: 5px 8px; font-size: 11px; width: auto; display: inline-block; }

        table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 12px; }
        th, td { padding: 8px; text-align: right; border-bottom: 1px solid #444; }
        th { color: var(--primary); }

        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); z-index: 1000; justify-content: center; align-items: center; }
        .modal-content { background: var(--light-dark); padding: 20px; border-radius: 10px; width: 92%; max-width: 650px; max-height: 90vh; overflow-y: auto; border: 1px solid var(--primary); }
        .close-modal { float: left; color: var(--danger); cursor: pointer; font-size: 22px; font-weight: bold; }
        
        .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 10px; }
        .stat-box { background: #333; padding: 12px; border-radius: 8px; text-align: center; cursor: pointer; border: 1px solid transparent; }
        .stat-box:hover { border-color: var(--primary); }
        .stat-box span { display: block; font-size: 12px; color: var(--gray); }
        .stat-box strong { font-size: 16px; color: var(--primary); }

        .full-width-stat {
            background: #2a2a2a;
            padding: 12px;
            border-radius: 8px;
            text-align: center;
            border: 1px solid var(--primary);
            margin-bottom: 15px;
        }
        .full-width-stat span { display: block; font-size: 13px; color: var(--gray); font-weight: bold; }
        .full-width-stat strong { font-size: 20px; color: var(--primary); }
        
        .detail-row { display: flex; justify-content: space-between; margin-bottom: 8px; border-bottom: 1px solid #333; padding-bottom: 4px; font-size: 13px; }

        .ticker-wrap {
            width: 100%;
            background-color: #111;
            border: 1px solid #333;
            border-radius: 6px;
            overflow: hidden;
            margin-bottom: 12px;
            padding: 8px 0;
        }
        .ticker-move {
            display: inline-block;
            white-space: nowrap;
            padding-left: 100%;
            animation: ticker 42s linear 3 forwards;
            font-size: 12px;
            color: #aaaaaa;
        }
        .ticker-move span {
            margin-left: 15px;
            color: var(--primary);
            font-weight: bold;
        }
        @keyframes ticker {
            0% { transform: translate3d(-100%, 0, 0); }
            100% { transform: translate3d(100%, 0, 0); }
        }

        .payment-split-box {
            background: #222;
            padding: 10px;
            border-radius: 6px;
            margin-bottom: 12px;
            border: 1px dashed #444;
        }

        .calc-box {
            background: #1a1a1a;
            padding: 6px;
            border-radius: 5px;
            margin-bottom: 6px;
            border: 1px solid #444;
        }
        .calc-box input {
            margin-bottom: 0;
            background: #111;
            font-size: 13px;
        }

        .image-gallery {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            justify-content: center;
            margin-top: 10px;
        }
        .image-gallery img {
            max-width: 100%;
            max-height: 60vh;
            border-radius: 8px;
            border: 1px solid var(--primary);
        }

        .pdf-template { background: #ffffff !important; color: #000000 !important; padding: 20px; border-radius: 5px; font-family: Tahoma, sans-serif; }
    </style>
</head>
<body>

    <header id="mainHeader">الأسطول الذهبي 🚖</header>

    <div class="nav-tabs" id="mainNavTabs">
        <div class="nav-tab active" onclick="switchTab('revenues', this)">الإيرادات</div>
        <div class="nav-tab" onclick="checkPinAndSwitch('drivers', this)">السائقين 🔐</div>
        <div class="nav-tab" onclick="checkPinAndSwitch('cars', this)">السيارات 🔐</div>
        <div class="nav-tab" onclick="checkPinAndSwitch('archive', this)">الأرشيف الشهري 🔐</div>
        <div class="nav-tab" onclick="checkPinAndSwitch('debts', this)">الديون 🔐</div>
        <div class="nav-tab" onclick="checkPinAndSwitch('associations', this)">الجمعيات 🔐</div>
        <div class="nav-tab" onclick="checkPinAndSwitch('treasury', this)">الخزنة 🔐</div>
    </div>

    <div class="container">

        <!-- واجهة العرض العامة للروابط المشاركة -->
        <div id="sharedViewSection" class="card" style="display:none; margin-top:20px;">
            <h2 id="sharedTitle">كشف حساب مخصص</h2>
            <div id="sharedBody">جاري تحميل البيانات...</div>
        </div>

        <!-- 1. شاشة تسجيل الإيرادات -->
        <div id="revenues" class="section active">
            <div class="card">
                <h2 id="revFormTitle">تسجيل رحلة / إيراد جديد</h2>
                <form id="revenueForm" onsubmit="saveRevenue(event)">
                    <input type="hidden" id="revTripId">
                    <label>السيارة</label>
                    <select id="revCar" required><option value="">جاري التحميل...</option></select>
                    <label>السائق</label>
                    <select id="revDriver" required><option value="">جاري التحميل...</option></select>
                    
                    <!-- آلة حاسبة ومجموع الإيراد الكلي -->
                    <label style="color: var(--primary); font-weight: bold;">آلة حاسبة للإيراد الكلي (اكتب المبالغ مثل 100+150+50):</label>
                    <div class="calc-box">
                        <input type="text" id="calcTotalRev" placeholder="مثال: 150+200+80" oninput="calculateExpression('calcTotalRev', 'totalRev')">
                    </div>
                    <label>مجموع الإيراد الكلي النهائي</label>
                    <input type="number" id="totalRev" step="any" required placeholder="0.00">
                    
                    <div class="payment-split-box">
                        <label style="color:var(--primary); font-weight:bold;">توزيع طريقة الدفع للإيراد (يجب أن يساوي الصافي أو الإجمالي):</label>
                        <div style="display:grid; grid-template-columns: 1fr; gap:10px;">
                            <div>
                                <label>نقدي (كاش)</label>
                                <input type="number" id="payCash" step="any" value="0">
                                <label style="font-size:11px;">صور سكرين / إيصال الكاش (اختياري)</label>
                                <input type="file" id="payCashImg" accept="image/*" multiple>
                            </div>
                            <hr style="border-color:#333;">
                            <div>
                                <label>فودافون كاش</label>
                                <input type="number" id="payVodafone" step="any" value="0">
                                <label style="font-size:11px;">صور سكرين تحويل فودافون كاش (اختياري)</label>
                                <input type="file" id="payVodafoneImg" accept="image/*" multiple>
                            </div>
                            <hr style="border-color:#333;">
                            <div>
                                <label>انستا باي</label>
                                <input type="number" id="payInstapay" step="any" value="0">
                                <label style="font-size:11px;">صور سكرين تحويل انستا باي (اختياري)</label>
                                <input type="file" id="payInstapayImg" accept="image/*" multiple>
                            </div>
                        </div>
                    </div>

                    <!-- آلة حاسبة ومجموع البنزين -->
                    <label style="color: var(--primary); font-weight: bold;">آلة حاسبة لمجموع البنزين (اكتب المبالغ مثل 50+100):</label>
                    <div class="calc-box">
                        <input type="text" id="calcTripFuel" placeholder="مثال: 50+80" oninput="calculateExpression('calcTripFuel', 'tripFuel')">
                    </div>
                    <label>مجموع بنزين الرحلة النهائي</label>
                    <input type="number" id="tripFuel" step="any" value="0" required>

                    <!-- آلة حاسبة ومجموع المصاريف الشخصية -->
                    <label style="color: var(--primary); font-weight: bold;">آلة حاسبة للمصروف الشخصي (اكتب المبالغ مثل 20+30):</label>
                    <div class="calc-box">
                        <input type="text" id="calcPersonalExp" placeholder="مثال: 20+30" oninput="calculateExpression('calcPersonalExp', 'personalExp')">
                    </div>
                    <label>مجموع المصاريف الشخصية للسائق النهائي</label>
                    <input type="number" id="personalExp" step="any" value="0" required>

                    <!-- آلة حاسبة وكرت الطريق -->
                    <label style="color: var(--primary); font-weight: bold;">آلة حاسبة لكرت الطريق/المطار (اكتب المبالغ مثل 15+25):</label>
                    <div class="calc-box">
                        <input type="text" id="calcRoadFee" placeholder="مثال: 15+25" oninput="calculateExpression('calcRoadFee', 'roadFee')">
                    </div>
                    <label>إجمالي كرت طريق أو مطار النهائي</label>
                    <input type="number" id="roadFee" step="any" value="0" required>

                    <!-- آلة حاسبة ومصاريف الأكل -->
                    <label style="color: var(--primary); font-weight: bold;">آلة حاسبة لمصاريف الأكل (اكتب المبالغ مثل 40+60):</label>
                    <div class="calc-box">
                        <input type="text" id="calcFoodExp" placeholder="مثال: 40+60" oninput="calculateExpression('calcFoodExp', 'foodExp')">
                    </div>
                    <label>إجمالي مصاريف الأكل النهائي</label>
                    <input type="number" id="foodExp" step="any" value="0" required>

                    <button type="submit" id="revSubmitBtn" style="margin-top:10px;">حفظ وتوزيع الحسابات تلقائياً</button>
                    <button type="button" id="revCancelBtn" onclick="resetRevenueForm()" style="background:#555; color:#fff; margin-top:5px; display:none;">إلغاء التعديل</button>
                </form>
            </div>

            <div class="card">
                <h2>سجل حركات ورحلات الإيرادات</h2>
                <div style="overflow-x: auto;">
                    <table>
                        <thead>
                            <tr>
                                <th>التاريخ</th>
                                <th>السيارة / السائق</th>
                                <th>الإيراد والمصاريف</th>
                                <th>الصافي ونسبة السائق</th>
                                <th>صور السكرين</th>
                                <th>تحكم</th>
                            </tr>
                        </thead>
                        <tbody id="tripsLogTable">
                            <tr><td colspan="6" style="text-align:center;">جاري التحميل...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 2. شاشة السائقين -->
        <div id="drivers" class="section">
            <div class="card">
                <h2 id="driverFormTitle">إضافة سائق جديد</h2>
                <form id="driverForm" onsubmit="saveOrUpdateDriver(event)">
                    <input type="hidden" id="dId">
                    <label>اسم السائق</label>
                    <input type="text" id="dName" required>
                    <label>العنوان</label>
                    <input type="text" id="dAddress" required>
                    <label>رقم الموبايل</label>
                    <input type="text" id="dPhone" required>
                    <label>النسبة المئوية من صافي الرحلة (%)</label>
                    <input type="number" id="dPercentage" step="any" required placeholder="50">
                    <label>الرصيد الافتتاحي / التراكمي</label>
                    <input type="number" id="dOpeningBalance" step="any" value="0" required>
                    <button type="submit" id="driverSubmitBtn">حفظ السائق</button>
                    <button type="button" id="driverCancelBtn" onclick="resetDriverForm()" style="background:#555; color:#fff; margin-top:5px; display:none;">إلغاء</button>
                </form>
            </div>
            <div class="card">
                <h2>قائمة السائقين (الدورة الحالية)</h2>
                <div id="driversList">جاري التحميل...</div>
            </div>
            <div class="card" style="text-align: center;">
                <button class="btn-info" onclick="changePinPrompt('drivers')">تغيير كلمة مرور شاشة السائقين</button>
            </div>
        </div>

        <!-- 3. شاشة السيارات -->
        <div id="cars" class="section">
            <div class="card">
                <h2 id="carFormTitle">إضافة سيارة جديدة</h2>
                <form id="carForm" onsubmit="saveOrUpdateCar(event)">
                    <input type="hidden" id="cId">
                    <label>ماركة واسم السيارة والموديل</label>
                    <input type="text" id="cModel" required placeholder="هيونداي إلنترا 2024">
                    <label>رقم اللوحة للسيارة</label>
                    <input type="text" id="cPlateNumber" required placeholder="أ ب ج 1234">
                    
                    <label>نوع الحيازة</label>
                    <select id="cOwnership" onchange="toggleRentFields()" required>
                        <option value="ملك">ملك</option>
                        <option value="إيجار">إيجار</option>
                    </select>

                    <div id="rentFields" style="display:none;">
                        <label>اسم المالك</label>
                        <input type="text" id="cOwnerName">
                        <label>رقم المالك</label>
                        <input type="text" id="cOwnerPhone">
                        <label>قيمة الإيجار الشهري</label>
                        <input type="number" id="cMonthlyRent" step="any">
                        <label>ميعاد الإيجار الشهري (اليوم)</label>
                        <input type="number" id="cRentDueDate" placeholder="1">
                    </div>

                    <label>حساب انستا (Instapay)</label>
                    <input type="text" id="cInstapay">
                    <label>رقم فودافون كاش</label>
                    <input type="text" id="cVodafoneCash">
                    <label>الرصيد الافتتاحي للسيارة</label>
                    <input type="number" id="cOpeningBalance" step="any" value="0" required>

                    <button type="submit" id="carSubmitBtn">حفظ السيارة</button>
                    <button type="button" id="carCancelBtn" onclick="resetCarForm()" style="background:#555; color:#fff; margin-top:5px; display:none;">إلغاء</button>
                </form>
            </div>
            <div class="card">
                <h2>قائمة السيارات (الدورة الحالية من يوم 5)</h2>
                <div id="carsList">جاري التحميل...</div>
            </div>
            <div class="card" style="text-align: center;">
                <button class="btn-info" onclick="changePinPrompt('cars')">تغيير كلمة مرور شاشة السيارات</button>
            </div>
        </div>

        <!-- 4. شاشة الأرشيف الشهري -->
        <div id="archive" class="section">
            <div class="card">
                <h2>الأرشيف الشهري المتقدم للحسابات (من يوم 5 إلى يوم 4)</h2>
                <div style="display: flex; gap: 10px; margin-bottom: 10px;">
                    <div style="flex: 1;">
                        <label>السنة</label>
                        <select id="archiveYear" onchange="loadArchiveData()"></select>
                    </div>
                    <div style="flex: 1;">
                        <label>دورة الشهر</label>
                        <select id="archiveMonth" onchange="loadArchiveData()">
                            <option value="1">يناير (5 يناير - 4 فبراير)</option>
                            <option value="2">فبراير (5 فبراير - 4 مارس)</option>
                            <option value="3">مارس (5 مارس - 4 أبريل)</option>
                            <option value="4">أبريل (5 أبريل - 4 مايو)</option>
                            <option value="5">مايو (5 مايو - 4 يونيو)</option>
                            <option value="6">يونيو (5 يونيو - 4 يوليو)</option>
                            <option value="7">يوليو (5 يوليو - 4 أغسطس)</option>
                            <option value="8">أغسطس (5 أغسطس - 4 سبتمبر)</option>
                            <option value="9">سبتمبر (5 سبتمبر - 4 أكتوبر)</option>
                            <option value="10">أكتوبر (5 أكتوبر - 4 نوفمبر)</option>
                            <option value="11">نوفمبر (5 نوفمبر - 4 ديسمبر)</option>
                            <option value="12">ديسمبر (5 ديسمبر - 4 يناير)</option>
                        </select>
                    </div>
                </div>
                <button class="btn-pdf" onclick="exportFullArchivePDF()" style="margin-top: 5px;">تصدير تقرير الشهر الشامل بالكامل (PDF)</button>
            </div>

            <div id="archivePrintArea">
                <div class="card">
                    <h2>أرشيف السائقين لهذه الدورة</h2>
                    <div id="archiveDriversList">اختر الشهر لعرض البيانات...</div>
                </div>

                <div class="card">
                    <h2>أرشيف السيارات لهذه الدورة</h2>
                    <div id="archiveCarsList">اختر الشهر لعرض البيانات...</div>
                </div>
            </div>
            <div class="card" style="text-align: center;">
                <button class="btn-info" onclick="changePinPrompt('archive')">تغيير كلمة مرور شاشة الأرشيف الشهري</button>
            </div>
        </div>

        <!-- 5. شاشة الديون -->
        <div id="debts" class="section">
            <div class="card">
                <h2 id="debtFormTitle">تسجيل دين جديد</h2>
                <form id="debtForm" onsubmit="saveOrUpdateDebt(event)">
                    <input type="hidden" id="debtId">
                    <label>نوع الدين</label>
                    <select id="debtType" onchange="toggleDebtFields()" required>
                        <option value="ثابت">دين ثابت</option>
                        <option value="فائدة">دين بفائدة شهرية</option>
                    </select>

                    <label>اسم الدائن</label>
                    <input type="text" id="debtName" required placeholder="اسم الشخص أو الجهة">

                    <label>رقم الموبايل</label>
                    <input type="text" id="debtPhone" required placeholder="رقم الهاتف">

                    <div id="fixedDebtFields">
                        <label>قيمة الدين الثابت</label>
                        <input type="number" id="debtAmount" step="any" placeholder="المبلغ الكلي للدين">
                        <label>ميعاد سداد الدين الثابت (تاريخ كامل)</label>
                        <input type="date" id="debtFixedDueDate">
                    </div>

                    <div id="interestDebtFields" style="display:none;">
                        <label>أصل الدين</label>
                        <input type="number" id="debtPrincipal" step="any" placeholder="المبلغ الأصلي">
                        
                        <label>الفائدة الشهرية</label>
                        <input type="number" id="debtMonthlyInterest" step="any" placeholder="مبلغ الفائدة الشهرية">
                        
                        <label>يوم السداد الشهري (اليوم من كل شهر)</label>
                        <input type="number" id="debtInterestDueDateDay" placeholder="مثال: 10">
                    </div>

                    <button type="submit" id="debtSubmitBtn">حفظ الدين</button>
                    <button type="button" id="debtCancelBtn" onclick="resetDebtForm()" style="background:#555; color:#fff; margin-top:5px; display:none;">إلغاء التعديل</button>
                </form>
            </div>
            <div class="card">
                <h2>قائمة الديون</h2>
                <div id="debtsList">جاري التحميل...</div>
            </div>
            <div class="card" style="text-align: center;">
                <button class="btn-info" onclick="changePinPrompt('debts')">تغيير كلمة مرور شاشة الديون</button>
            </div>
        </div>

        <!-- 6. شاشة الجمعيات -->
        <div id="associations" class="section">
            <div class="card">
                <h2 id="assocFormTitle">تسجيل جمعية جديدة</h2>
                <form id="assocForm" onsubmit="saveOrUpdateAssociation(event)">
                    <input type="hidden" id="assocId">
                    <label>اسم الجمعية / صاحب الجمعية</label>
                    <input type="text" id="assocName" required placeholder="مثال: جمعية الأصدقاء">
                    <label>رقم الموبايل</label>
                    <input type="text" id="assocPhone" required>
                    <label>إجمالي عدد أدوار الجمعية</label>
                    <input type="number" id="assocTotalRounds" required placeholder="10">
                    <label>أدوار القبض الخاصة بنا</label>
                    <input type="text" id="assocMyRounds" required placeholder="3 و 7">
