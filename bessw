    <script>
        const firebaseConfig = {
            databaseURL: "https://fleetsmart-2513b-default-rtdb.firebaseio.com"
        };
        if (!firebase.apps.length) {
            firebase.initializeApp(firebaseConfig);
        }
        const db = firebase.database();
        const defaultPin = "6352";

        let carsMap = {};
        let driversMap = {};
        let currentTreasuryFilter = 'الكل';

        function calculateExpression(calcInputId, targetInputId) {
            const expr = document.getElementById(calcInputId).value;
            if (!expr) {
                document.getElementById(targetInputId).value = 0;
                return;
            }
            try {
                // حماية وتقييم المجموع الحسابي تلقائياً
                const sanitizedExpr = expr.replace(/[^0-9+.-]/g, '');
                if (sanitizedExpr) {
                    const result = Function('"use strict";return (' + sanitizedExpr + ')')();
                    document.getElementById(targetInputId).value = isNaN(result) ? 0 : result;
                }
            } catch (err) {
                // في حالة وجود صيغة غير مكتملة يتجاهل الخطأ المؤقت
            }
        }

        function getCycleRange(year, month) {
            let start = new Date(year, month - 1, 5, 0, 0, 0);
            let end = new Date(year, month, 4, 23, 59, 59);
            return { start, end };
        }

        function getCurrentCycle() {
            let now = new Date();
            let day = now.getDate();
            let year = now.getFullYear();
            let month = now.getMonth() + 1;
            
            if (day < 5) {
                month--;
                if (month === 0) {
                    month = 12;
                    year--;
                }
            }
            return { year, month };
        }

        function checkPinAndSwitch(tabId, element) {
            db.ref(`settings/pins/${tabId}`).once('value').then(snapshot => {
                let currentPin = snapshot.exists() ? snapshot.val() : defaultPin;
                let enteredPin = prompt("أدخل الرقم السري للوصول لـ " + element.innerText + ":");
                if (enteredPin === currentPin) {
                    switchTab(tabId, element);
                } else if (enteredPin !== null) {
                    alert("الرقم السري غير صحيح!");
                }
            }).catch(() => {
                let enteredPin = prompt("أدخل الرقم السري للوصول لهذه الشاشة:");
                if (enteredPin === defaultPin) switchTab(tabId, element);
                else if (enteredPin !== null) alert("الرقم السري غير صحيح!");
            });
        }

        function changePinPrompt(sectionKey) {
            let entered = prompt("أدخل الرقم السري الحالي:");
            db.ref(`settings/pins/${sectionKey}`).once('value').then(snapshot => {
                let currentPin = snapshot.exists() ? snapshot.val() : defaultPin;
                if (entered === currentPin) {
                    let newPin = prompt("أدخل الرقم السري الجديد:");
                    if (newPin) {
                        db.ref(`settings/pins/${sectionKey}`).set(newPin).then(() => {
                            alert("تم تغيير الرقم السري بنجاح!");
                        });
                    }
                } else if (entered !== null) {
                    alert("الرقم السري غير صحيح!");
                }
            });
        }

        function switchTab(tabId, element) {
            document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
            document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
            document.getElementById(tabId).classList.add('active');
            if(element) element.classList.add('active');

            if (tabId === 'treasury') {
                updateSecretTickerData();
            }
        }

        function closeModal(modalId) {
            document.getElementById(modalId).style.display = 'none';
        }

        function toggleRentFields() {
            const val = document.getElementById('cOwnership').value;
            document.getElementById('rentFields').style.display = (val === 'إيجار') ? 'block' : 'none';
        }

        function toggleDebtFields() {
            const type = document.getElementById('debtType').value;
            if (type === 'ثابت') {
                document.getElementById('fixedDebtFields').style.display = 'block';
                document.getElementById('interestDebtFields').style.display = 'none';
            } else {
                document.getElementById('fixedDebtFields').style.display = 'none';
                document.getElementById('interestDebtFields').style.display = 'block';
            }
        }

        function generateShareLink(type, id) {
            let baseUrl = window.location.href.split('?')[0];
            let shareUrl = `${baseUrl}?type=${type}&id=${id}`;
            navigator.clipboard.writeText(shareUrl).then(() => {
                alert(`تم نسخ رابط كشف الحساب المخصص بنجاح:\n${shareUrl}`);
            }).catch(() => {
                prompt("انسخ رابط المشاركة المخصص التالي:", shareUrl);
            });
        }

        window.onload = function() {
            const urlParams = new URLSearchParams(window.location.search);
            const shareType = urlParams.get('type');
            const shareId = urlParams.get('id');

            if (shareType && shareId) {
                document.getElementById('mainHeader').innerText = "الأسطول الذهبي - كشف حساب مخصص 🚖";
                document.getElementById('mainNavTabs').style.display = 'none';
                document.querySelectorAll('.section').forEach(s => s.style.display = 'none');
                document.getElementById('sharedViewSection').style.display = 'block';
                loadSharedAccountView(shareType, shareId);
            } else {
                initArchiveYearDropdown();
                loadDropdowns();
                loadDriversList();
                loadCarsList();
                loadDebtsList();
                loadAssociationsList();
                loadTreasuryData();
                loadTripsLogTable();
                updateSecretTickerData();
            }
        };

        function loadSharedAccountView(type, id) {
            if (type === 'driver') {
                db.ref(`drivers/${id}`).once('value', drvSnap => {
                    if (!drvSnap.exists()) { document.getElementById('sharedBody').innerHTML = 'عذراً، هذا الحساب غير موجود'; return; }
                    let drv = drvSnap.val();
                    document.getElementById('sharedTitle').innerText = `كشف حساب السائق: ${drv.name}`;
                    db.ref('trips').orderByChild('driverId').equalTo(id).once('value', tripsSnap => {
                        let totalNetJob = 0; let totalShare = 0;
                        let html = '<table><thead><tr><th>التاريخ</th><th>صافي شغل الرحلة</th><th>المستحق لك</th></tr></thead><tbody>';
                        if (tripsSnap.exists()) {
                            tripsSnap.forEach(c => {
                                let t = c.val();
                                let tripNet = Number(t.netRevenue || (t.totalRev - t.totalExpenses) || 0);
                                totalNetJob += tripNet;
                                totalShare += Number(t.driverShare || 0);
                                html += `<tr><td>${t.timestamp}</td><td>${tripNet} ج.م</td><td style="color:var(--primary); font-weight:bold;">${t.driverShare} ج.م</td></tr>`;
                            });
                        } else {
                            html += '<tr><td colspan="3" style="text-align:center;">لا توجد رحلات سابقة</td></tr>';
                        }
                        
                        let cumulativeBalance = Number(drv.balance !== undefined ? drv.balance : (drv.openingBalance || 0));
                        html += `</tbody></table>
                            <hr style="border-color:#444; margin:15px 0;">
                            <div class="detail-row"><span>إجمالي شغل السائق (بعد خصم المصاريف):</span> <strong>${totalNetJob} ج.م</strong></div>
                            <div class="detail-row"><span>إجمالي مستحقات الشغل الصافية:</span> <strong style="color:var(--primary);">${totalShare} ج.م</strong></div>
                            <div class="detail-row"><span>الرصيد التراكمي المتبقي لك/عليك:</span> <strong style="color:${cumulativeBalance >= 0 ? 'var(--success)' : 'var(--danger)'}; font-size:16px;">${cumulativeBalance} ج.م</strong></div>
                        `;
                        document.getElementById('sharedBody').innerHTML = html;
                    });
                });
            } else if (type === 'debt') {
                db.ref(`debts/${id}`).once('value', debtSnap => {
                    if (!debtSnap.exists()) { document.getElementById('sharedBody').innerHTML = 'عذراً، هذا الحساب غير موجود'; return; }
                    let d = debtSnap.val();
                    document.getElementById('sharedTitle').innerText = `كشف حساب الدين: ${d.name}`;
                    let remaining = (d.amount || 0) - (d.paidAmount || 0);
                    db.ref('debt_transactions').orderByChild('debtId').equalTo(id).once('value', transSnap => {
                        let html = '<table><thead><tr><th>التاريخ</th><th>النوع</th><th>المبلغ</th><th>الطريقة</th><th>البيان</th></tr></thead><tbody>';
                        if (transSnap.exists()) {
                            transSnap.forEach(p => {
                                let tr = p.val();
                                let color = tr.actionType === 'تسليم (سداد)' ? 'var(--danger)' : 'var(--success)';
                                html += `<tr><td>${tr.timestamp}</td><td style="color:${color}; font-weight:bold;">${tr.actionType}</td><td>${tr.amount} ج.م</td><td>${tr.method || 'كاش'}</td><td>${tr.note || '-'}</td></tr>`;
                            });
                        } else {
                            html += '<tr><td colspan="5" style="text-align:center;">لا توجد حركات سابقة</td></tr>';
                        }
                        html += `</tbody></table>
                            <hr style="border-color:#444; margin:15px 0;">
                            ${d.type === 'فائدة' ? `
                                <div class="detail-row"><span>أصل الدين:</span> <strong>${d.principal} ج.م</strong></div>
                                <div class="detail-row"><span>الفائدة الشهرية:</span> <strong style="color:var(--primary);">${d.monthlyInterest} ج.م</strong></div>
                            ` : `
                                <div class="detail-row"><span>المبلغ الأصلي:</span> <strong>${d.amount || 0} ج.م</strong></div>
                                <div class="detail-row"><span>المسدد:</span> <strong style="color:var(--success);">${d.paidAmount || 0} ج.م</strong></div>
                                <div class="detail-row"><span>المتبقي:</span> <strong style="color:var(--danger);">${remaining} ج.م</strong></div>
                            `}
                        `;
                        document.getElementById('sharedBody').innerHTML = html;
                    });
                });
            } else if (type === 'car') {
                db.ref(`cars/${id}`).once('value', carSnap => {
                    if (!carSnap.exists()) { document.getElementById('sharedBody').innerHTML = 'عذراً، هذه السيارة غير موجودة'; return; }
                    let c = carSnap.val();
                    document.getElementById('sharedTitle').innerText = `كشف حساب السيارة: ${c.model}`;
                    
                    let curr = getCurrentCycle();
                    let cycle = getCycleRange(curr.year, curr.month);

                    db.ref('trips').orderByChild('carId').equalTo(id).once('value', tripsSnap => {
                        let totalJob = 0; let totalExpenses = 0; let totalDriverShares = 0;
                        tripsSnap.forEach(child => {
                            let t = child.val();
                            let tripDate = t.isoDate ? new Date(t.isoDate) : new Date();
                            if (tripDate >= cycle.start && tripDate <= cycle.end) {
                                totalJob += Number(t.totalRev || 0);
                                totalExpenses += Number(t.totalExpenses || 0);
                                totalDriverShares += Number(t.driverShare || 0);
                            }
                        });

                        db.ref('car_expenses').orderByChild('carId').equalTo(id).once('value', expSnap => {
                            let extraMaint = 0;
                            if (expSnap.exists()) {
                                expSnap.forEach(e => {
                                    let ex = e.val();
                                    let exDate = ex.isoDate ? new Date(ex.isoDate) : new Date();
                                    if (exDate >= cycle.start && exDate <= cycle.end) {
                                        extraMaint += Number(ex.amount || 0);
                                    }
                                });
                            }

                            let grandTotalCarExpenses = totalExpenses + totalDriverShares + extraMaint;
                            let netProfit = (c.openingBalance || 0) + totalJob - grandTotalCarExpenses - (c.ownership === 'إيجار' ? Number(c.monthlyRent || 0) : 0);

                            let html = `
                                <div class="detail-row"><span>الموديل:</span> <strong>${c.model} (${c.plateNumber || ''})</strong></div>
                                <div class="detail-row"><span>إجمالي شغل الدورة:</span> <strong>${totalJob} ج.م</strong></div>
                                <div class="detail-row"><span>مصاريف التشغيل + الصيانة:</span> <strong>${totalExpenses + extraMaint} ج.م</strong></div>
                                <div class="detail-row"><span>إجمالي نسب السائقين:</span> <strong>${totalDriverShares} ج.م</strong></div>
                                <div class="detail-row"><span>إجمالي المصاريف الشاملة:</span> <strong style="color:var(--danger);">${grandTotalCarExpenses} ج.م</strong></div>
                                <div class="detail-row"><span>صافي ربح السيارة الحالي:</span> <strong style="color:var(--primary); font-size:16px;">${netProfit} ج.م</strong></div>
                            `;
                            document.getElementById('sharedBody').innerHTML = html;
                        });
                    });
                });
            } else if (type === 'assoc') {
                db.ref(`associations/${id}`).once('value', assocSnap => {
                    if (!assocSnap.exists()) { document.getElementById('sharedBody').innerHTML = 'عذراً، الجمعية غير موجودة'; return; }
                    let a = assocSnap.val();
                    document.getElementById('sharedTitle').innerText = `كشف حساب جمعية: ${a.name}`;
                    let paidCount = a.paidRoundsCount || 0;
                    let remainingRounds = a.totalRounds - paidCount;
                    let totalPaidMoney = paidCount * a.installment;
                    let html = `
                        <div class="detail-row"><span>الجمعية / الموبايل:</span> <strong>${a.name} (${a.phone})</strong></div>
                        <div class="detail-row"><span>الأدوار المدفوعة:</span> <strong style="color:var(--success);">${paidCount} دور (${totalPaidMoney} ج.م)</strong></div>
                        <div class="detail-row"><span>الأدوار المتبقية:</span> <strong style="color:var(--danger);">${remainingRounds} دور</strong></div>
                    `;
                    document.getElementById('sharedBody').innerHTML = html;
                });
            }
        }

        function initArchiveYearDropdown() {
            let select = document.getElementById('archiveYear');
            let currentYear = new Date().getFullYear();
            select.innerHTML = '';
            for (let y = currentYear; y >= currentYear - 3; y--) {
                select.innerHTML += `<option value="${y}">${y}</option>`;
            }
            let curr = getCurrentCycle();
            document.getElementById('archiveMonth').value = curr.month;
