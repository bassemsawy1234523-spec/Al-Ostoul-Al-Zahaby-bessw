        function updateSecretTickerData() {
            let totalDebtsThisMonth = 0;
            let totalCarRentThisMonth = 0;
            let totalAssocThisMonth = 0;
            let currentTreasuryBalance = 0;

            let now = new Date();
            let currentYear = now.getFullYear();
            let currentMonth = now.getMonth() + 1;

            db.ref('treasury_logs').once('value', tSnap => {
                let inc = 0; let exp = 0;
                tSnap.forEach(c => {
                    let log = c.val();
                    if (log.type === 'إيداع') inc += Number(log.amount);
                    else exp += Number(log.amount);
                });
                currentTreasuryBalance = inc - exp;

                db.ref('debts').once('value', debtSnap => {
                    debtSnap.forEach(c => {
                        let d = c.val();
                        if (d.type === 'فائدة') {
                            totalDebtsThisMonth += Number(d.monthlyInterest || 0);
                        } else {
                            let rem = (Number(d.amount) || 0) - (Number(d.paidAmount) || 0);
                            if (rem > 0 && d.dueDate) {
                                let dueDateObj = new Date(d.dueDate);
                                if (!isNaN(dueDateObj) && dueDateObj.getFullYear() == currentYear && (dueDateObj.getMonth() + 1) == currentMonth) {
                                    totalDebtsThisMonth += rem;
                                }
                            }
                        }
                    });

                    db.ref('associations').once('value', assocSnap => {
                        assocSnap.forEach(c => {
                            let a = c.val();
                            if ((a.paidRoundsCount || 0) < (a.totalRounds || 0)) {
                                totalAssocThisMonth += Number(a.installment || 0);
                            }
                        });

                        db.ref('cars').once('value', carSnap => {
                            carSnap.forEach(c => {
                                let car = c.val();
                                if (car.ownership === 'إيجار') {
                                    totalCarRentThisMonth += Number(car.monthlyRent || 0);
                                }
                            });

                            let totalRequired = totalDebtsThisMonth + totalCarRentThisMonth + totalAssocThisMonth;
                            let remainingAfterCoverage = currentTreasuryBalance - totalRequired;

                            let tickerText = `
                                📌 [مستحقات هذا الشهر] 
                                مستحقات الديون هذا الشهر: <span>${totalDebtsThisMonth} ج.م</span> | 
                                مجموع الإيجارات: <span>${totalCarRentThisMonth} ج.م</span> | 
                                مستحق الجمعيات: <span>${totalAssocThisMonth} ج.م</span> | 
                                اجمالي المستحق: <span>${totalRequired} ج.م</span> | 
                                الباقي (في الخزنة بعد التغطية): <span style="color:${remainingAfterCoverage >= 0 ? '#28a745' : '#dc3545'};">${remainingAfterCoverage} ج.م</span>
                            `;
                            
                            let el = document.getElementById('secretTickerContent');
                            if(el) {
                                el.innerHTML = tickerText;
                                el.style.animation = 'none';
                                el.offsetHeight;
                                el.style.animation = 'ticker 42s linear 3 forwards';
                            }
                        });
                    });
                });
            });
        }

        function filesToMultipleBase64(fileInputId) {
            return new Promise((resolve) => {
                const fileInput = document.getElementById(fileInputId);
                if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
                    resolve([]);
                    return;
                }
                const files = Array.from(fileInput.files);
                const promises = files.map(file => {
                    return new Promise((res) => {
                        const reader = new FileReader();
                        reader.onload = e => res(e.target.result);
                        reader.onerror = () => res(null);
                        reader.readAsDataURL(file);
                    });
                });

                Promise.all(promises).then(results => {
                    resolve(results.filter(img => img !== null));
                });
            });
        }

