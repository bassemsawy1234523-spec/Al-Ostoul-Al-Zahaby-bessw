            e.preventDefault();
            let cat = document.getElementById('wCategory').value;
            let amount = Number(document.getElementById('wAmount').value);
            let method = document.getElementById('wMethod').value;
            let note = document.getElementById('wNote').value;

            if (amount <= 0) { alert('يرجى كتابة مبلغ صحيح'); return; }

            let receiptImages = await filesToMultipleBase64('wReceiptImgFile');

            let now = new Date();
            let timestamp = now.toLocaleString('ar-EG');
            let isoDate = now.toISOString();
            let updates = {};

            let treasuryRef = db.ref('treasury_logs').push().key;

            if (cat === 'عام') {
                updates[`treasury_logs/${treasuryRef}`] = {
                    isoDate, timestamp, type: 'سحب', amount, method, note: `سحب عام: ${note}`, receiptImages
                };
            } else if (cat === 'سائق') {
                let driverId = document.getElementById('wDriverId').value;
                if (!driverId) { alert('يرجى اختيار السائق'); return; }
                let driverName = driversMap[driverId] || 'سائق';

                let wRef = db.ref('driver_withdrawals').push().key;

                updates[`treasury_logs/${treasuryRef}`] = {
                    isoDate, timestamp, type: 'سحب', amount, method, note: `مسحوبات/سلفة للسائق (${driverName}) - ${note}`, receiptImages,
                    relatedDriverId: driverId, relatedWithdrawalId: wRef
                };

                updates[`driver_withdrawals/${wRef}`] = {
                    driverId, amount, method, note, timestamp, isoDate, treasuryLogId: treasuryRef, receiptImages
                };

                updates[`drivers/${driverId}/balance`] = firebase.database.ServerValue.increment(-amount);
            } else if (cat === 'سيارة') {
                let carId = document.getElementById('wCarId').value;
                if (!carId) { alert('يرجى اختيار السيارة'); return; }
                let carModel = carsMap[carId] || 'سيارة';

                updates[`treasury_logs/${treasuryRef}`] = {
                    isoDate, timestamp, type: 'سحب', amount, method, note: `صيانة/مصاريف سيارة (${carModel}) - ${note}`, receiptImages
                };

                let expRef = db.ref('car_expenses').push().key;
                updates[`car_expenses/${expRef}`] = {
                    carId, amount, method, note, timestamp, isoDate, treasuryLogId: treasuryRef, receiptImages
                };
            }

            db.ref().update(updates).then(() => {
                alert('تم تسجيل عملية السحب والخصم بنجاح!');
                closeModal('withdrawModal');
                updateSecretTickerData();
            });
        }

        async function manualTreasuryAction(type) {
            if (type === 'سحب') {
                openWithdrawalModal();
                return;
            }
            let amount = prompt(`أدخل مبلغ الـ ${type}:`, "1000");
            if (!amount) return;
            let method = prompt("طريقة الدفع (كاش / فودافون كاش / انستا باي):", "كاش");
            if (!method) return;
            let note = prompt("البيان:", "إيداع يدوي للخزنة");
            if (!note) return;
            let receiptImg = prompt("رابط صورة السكرين (اختياري - أو اتركها فارغة):");
            let receiptImages = receiptImg ? [receiptImg] : [];

            let now = new Date();
            let timestamp = now.toLocaleString('ar-EG');
            let isoDate = now.toISOString();

            db.ref('treasury_logs').push({ isoDate, timestamp, type, amount: Number(amount), method, note, receiptImages }).then(() => {
                alert(`تم الـ ${type} بنجاح!`);
                updateSecretTickerData();
            });
        }

        function deleteTreasuryLog(logKey) {
            if (confirm("هل أنت متأكد من حذف هذه الحركة مباشرة من الخزنة؟ سيتم إلغاء أثرها تماماً (وإذا كانت سلفة سائق سيتم حذفها من حسابه ورصيده تلقائياً).")) {
                db.ref(`treasury_logs/${logKey}`).once('value').then(snapshot => {
                    if (!snapshot.exists()) return;
                    let log = snapshot.val();
                    let updates = {};

                    updates[`treasury_logs/${logKey}`] = null;

                    if (log.relatedDriverId && log.relatedWithdrawalId) {
                        updates[`driver_withdrawals/${log.relatedWithdrawalId}`] = null;
                        updates[`drivers/${log.relatedDriverId}/balance`] = firebase.database.ServerValue.increment(Number(log.amount));
                    }

                    db.ref().update(updates).then(() => {
                        alert("تم حذف حركة الخزنة وإلغاء أثرها المالي من حساب السائق بنجاح!");
                        updateSecretTickerData();
                    });
                });
            }
        }

        function filterTreasuryByMethod(method) {
            currentTreasuryFilter = method;
            document.getElementById('treasuryLogTitle').innerText = `سجل حركات الخزنة (طريقة الدفع: ${method})`;
            loadTreasuryData();
        }

        function loadTreasuryData() {
            db.ref('treasury_logs').on('value', snapshot => {
                let totalIncome = 0; let totalExpenses = 0; 
                let cashTotal = 0; let vodafoneTotal = 0; let instapayTotal = 0;
                let html = '';

                snapshot.forEach(child => {
                    let log = child.val();
                    let key = child.key;
                    let amt = Number(log.amount || 0);
                    let m = log.method || 'كاش';

                    if (log.type === 'إيداع') {
                        totalIncome += amt;
                        if (m.includes('فودافون')) vodafoneTotal += amt;
                        else if (m.includes('انستا')) instapayTotal += amt;
                        else cashTotal += amt;
                    } else {
                        totalExpenses += amt;
                        if (m.includes('فودافون')) vodafoneTotal -= amt;
                        else if (m.includes('انستا')) instapayTotal -= amt;
                        else cashTotal -= amt;
                    }

                    if (currentTreasuryFilter === 'الكل' || m === currentTreasuryFilter || (currentTreasuryFilter === 'كاش' && m === 'كاش')) {
                        let images = log.receiptImages || (log.receiptImg ? [log.receiptImg] : []);
                        let imgBtn = images.length > 0 ? `<button class="btn-info btn-sm" onclick='showMultipleImageViewer(${JSON.stringify(images)})'>عرض (${images.length}) 🖼️</button>` : '-';
                        let rowColor = log.type === 'إيداع' ? 'var(--success)' : 'var(--danger)';
                        
                        html = `<tr>
                            <td>${log.timestamp}</td>
                            <td style="color:${rowColor}; font-weight:bold;">${log.type}</td>
                            <td>${log.amount} ج.م<br><small style="color:var(--primary)">${m}</small></td>
                            <td>${log.note || ''}</td>
                            <td>${imgBtn}</td>
                            <td><button class="btn-danger btn-sm" onclick="deleteTreasuryLog('${key}')">حذف 🗑️</button></td>
                        </tr>` + html;
                    }
                });

                if (!snapshot.exists()) html = '<tr><td colspan="6" style="text-align: center;">لا توجد حركات</td></tr>';
                
                let overallBalance = totalIncome - totalExpenses;

                document.getElementById('trTotalIncome').innerText = totalIncome + ' ج.م';
                document.getElementById('trTotalExpenses').innerText = totalExpenses + ' ج.م';
                document.getElementById('trTotalOverallBalance').innerText = overallBalance + ' ج.م';
                document.getElementById('trBalance').innerText = overallBalance + ' ج.م';
                
                document.getElementById('methodCash').innerText = cashTotal + ' ج.م';
                document.getElementById('methodVodafone').innerText = vodafoneTotal + ' ج.م';
                document.getElementById('methodInstapay').innerText = instapayTotal + ' ج.م';

                document.getElementById('treasuryLogTable').innerHTML = html;
            });
        }
    </script>
</body>
</html>
